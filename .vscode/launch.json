            "stopAtEntry": false,
            "console": "internalConsole",
            "internalConsoleOptions": "neverOpen"
        },
        {
            "name": "Debug iOS Simulator",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build-ios",
