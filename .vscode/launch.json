            "preLaunchTask": "build-windows",
            "program": "${workspaceFolder}/AiAudioRecoder/bin/Debug/net10.0-windows10.0.19041.0/win-x64/AiAudioRecoder.exe",
            "args": [],
            "cwd": "${workspaceFolder}/AiAudioRecoder",
            "stopAtEntry": false,
            "console": "internalConsole",
            "internalConsoleOptions": "neverOpen"
        },
        {
