<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="AiAudioRecoder.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:AiAudioRecoder"
    Title="AiAudioRecoder">

    <TabBar>
        <Tab Title="Запись" Icon="record.png">
            <ShellContent Route="records" ContentTemplate="{DataTemplate local:RecordPage}" />
        </Tab>
        <Tab Title="Транскрибировать" Icon="transcribe.png">
            <ShellContent Route="transcribe" ContentTemplate="{DataTemplate local:TranscribePage}" />
        </Tab>
        <Tab Title="Модели" Icon="model.png">
            <ShellContent Route="models" ContentTemplate="{DataTemplate local:ModelsPage}" />
        </Tab>
    </TabBar>

</Shell>
