<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Note: For Android please see also Platforms\Android\Resources\values\colors.xml -->

    <!-- VS Code Dark Theme inspired palette -->
    <Color x:Key="Primary">#007ACC</Color> <!-- VS Code blue -->
    <Color x:Key="PrimaryDark">#0060A8</Color>
    <Color x:Key="PrimaryDarkText">#1E1E1E</Color>
    <Color x:Key="Secondary">#1E1E1E</Color> <!-- Editor background -->
    <Color x:Key="SecondaryDarkText">#D4D4D4</Color> <!-- Default light foreground -->
    <Color x:Key="Tertiary">#3C3C3C</Color> <!-- Panel / side bar -->
    <Color x:Key="Accent">#C586C0</Color> <!-- Accent (purple) -->
    <Color x:Key="AccentWarning">#D16969</Color> <!-- Redish warning -->
    <Color x:Key="AccentInfo">#6796E6</Color> <!-- Lighter blue -->
    <Color x:Key="AccentSuccess">#4EC9B0</Color> <!-- Teal success -->

    <Color x:Key="White">#FFFFFF</Color>
    <Color x:Key="Black">#000000</Color>
    <Color x:Key="OffBlack">#111111</Color>

    <Color x:Key="Gray100">#F3F3F3</Color>
    <Color x:Key="Gray200">#E5E5E5</Color>
    <Color x:Key="Gray300">#D4D4D4</Color>
    <Color x:Key="Gray400">#C0C0C0</Color>
    <Color x:Key="Gray500">#858585</Color>
    <Color x:Key="Gray700">#3A3A3A</Color>
    <Color x:Key="Gray600">#4D4D4D</Color>
    <Color x:Key="Gray900">#252526</Color> <!-- VS Code editor background variant -->
    <Color x:Key="Gray950">#1E1E1E</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}"/>
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource Accent}"/>
    <SolidColorBrush x:Key="AccentWarningBrush" Color="{StaticResource AccentWarning}"/>
    <SolidColorBrush x:Key="AccentInfoBrush" Color="{StaticResource AccentInfo}"/>
    <SolidColorBrush x:Key="AccentSuccessBrush" Color="{StaticResource AccentSuccess}"/>

    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}"/>
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}"/>
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}"/>
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}"/>
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}"/>
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}"/>
    <SolidColorBrush x:Key="Gray700Brush" Color="{StaticResource Gray700}"/>
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}"/>
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}"/>
</ResourceDictionary>