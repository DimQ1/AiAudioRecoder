<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AiAudioRecoder.Views.RecordDetailPage"
             Title="Record Detail"
             BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray950}}">
    <ContentPage.Content>
        <Grid Padding="16" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Title -->
            <Label Grid.Row="0"
                   x:Name="TitleLabel"
                   Text="Details"
                   FontAttributes="Bold"
                   FontSize="22"
                   TextColor="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}" />

            <!-- Adaptive main content: side-by-side on wide screens, stacked on narrow screens -->
            <Grid Grid.Row="1"
                  x:Name="MainContentGrid"
                  ColumnSpacing="16"
                  RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Details panel (recognized text + audio player) -->
                <Border x:Name="DetailsBorder"
                        Grid.Row="0"
                        Grid.Column="0"
                        StrokeThickness="1"
                        Stroke="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}"
                        StrokeShape="RoundRectangle 12"
                        Padding="16">
                    <Grid RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Recognized text — always visible -->
                        <ScrollView Grid.Row="0" VerticalScrollBarVisibility="Auto">
                            <VerticalStackLayout Spacing="4">
                                <Label x:Name="ContentLabel"
                                       FontSize="16"
                                       IsVisible="False"
                                       TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource SecondaryDarkText}}"
                                       LineBreakMode="WordWrap" />
                                <Label x:Name="TranscriptionLabel"
                                       FontSize="16"
                                       IsVisible="False"
                                       TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource SecondaryDarkText}}"
                                       LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                        </ScrollView>

                        <!-- Audio playback panel -->
                        <Border Grid.Row="1"
                                x:Name="PlaybackPanel"
                                IsVisible="False"
                                StrokeThickness="1"
                                Stroke="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}"
                                StrokeShape="RoundRectangle 8"
                                Padding="12">
                            <VerticalStackLayout Spacing="8">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" VerticalOptions="Center">
                                    <Button x:Name="PlayPauseButton"
                                            WidthRequest="48"
                                            HeightRequest="48"
                                            CornerRadius="24"
                                            Text="Play"
                                            Clicked="OnPlayPauseClicked" />
                                    <VerticalStackLayout Grid.Column="1" Spacing="4">
                                        <Slider x:Name="PositionSlider"
                                                Minimum="0"
                                                Maximum="1"
                                                Value="0"
                                                IsEnabled="False" />
                                        <Grid ColumnDefinitions="Auto,*">
                                            <Label x:Name="CurrentTimeLabel"
                                                   Text="00:00"
                                                   FontSize="12"
                                                   TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource SecondaryDarkText}}" />
                                            <Label Grid.Column="1"
                                                   x:Name="TotalDurationLabel"
                                                   Text="00:00"
                                                   FontSize="12"
                                                   HorizontalOptions="End"
                                                   TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource SecondaryDarkText}}" />
                                        </Grid>
                                    </VerticalStackLayout>
                                </Grid>
                            </VerticalStackLayout>
                        </Border>
                    </Grid>
                </Border>

                <!-- Analysis panel -->
                <Border x:Name="AnalysisPanel"
                        Grid.Row="1"
                        Grid.Column="0"
                        StrokeThickness="1"
                        Stroke="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}"
                        StrokeShape="RoundRectangle 12"
                        Padding="16"
                        BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray900}}">
                    <Grid RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Label Grid.Row="0"
                               Text="Анализ текста"
                               FontAttributes="Bold"
                               FontSize="18"
                               TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />

                        <!-- Action buttons -->
                        <FlexLayout Grid.Row="1"
                                    Wrap="Wrap"
                                    JustifyContent="Start"
                                    AlignItems="Center"
                                    AlignContent="Start">
                            <Button Text="Настройки"
                                    Margin="0,0,8,4"
                                    Clicked="OnAnalysisSettingsClicked" />
                            <Button x:Name="AnalyzeTextButton"
                                    Text="Анализировать"
                                    Margin="0,0,8,4"
                                    Clicked="OnAnalyzeTextClicked" />
                            <Button Text="Копировать текст"
                                    Margin="0,0,8,4"
                                    Clicked="OnCopyAnalysisClicked" />
                            <Button x:Name="CancelAnalysisButton"
                                    Text="Отменить"
                                    Margin="0,0,0,4"
                                    IsVisible="False"
                                    Clicked="OnCancelAnalysisClicked" />
                        </FlexLayout>

                        <ActivityIndicator Grid.Row="2"
                                           x:Name="AnalysisActivityIndicator"
                                           IsVisible="False"
                                           IsRunning="False"
                                           HeightRequest="24"
                                           HorizontalOptions="Start" />

                        <Label Grid.Row="3"
                               x:Name="AnalysisStatusLabel"
                               FontSize="12"
                               TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource SecondaryDarkText}}"
                               Text="Настройки не загружены" />

                        <ScrollView Grid.Row="4">
                            <Editor x:Name="AnalysisResultEditor"
                                    IsReadOnly="True"
                                    AutoSize="TextChanges"
                                    MinimumHeightRequest="160"
                                    Placeholder="Результаты анализа появятся здесь" />
                        </ScrollView>
                    </Grid>
                </Border>
            </Grid>

            <!-- Bottom action buttons -->
            <HorizontalStackLayout Grid.Row="2" Spacing="12" HorizontalOptions="End">
                <Button Text="Копировать текст"
                        Clicked="OnCopyTextClicked"
                        WidthRequest="160" />
                <Button Text="Назад к записям"
                        Clicked="OnReturnToRecordsClicked"
                        WidthRequest="160" />
                <Button Text="Закрыть"
                        Clicked="OnCloseClicked"
                        WidthRequest="120" />
            </HorizontalStackLayout>
        </Grid>
    </ContentPage.Content>
</ContentPage>
