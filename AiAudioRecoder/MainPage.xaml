<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             x:Class="AiAudioRecoder.MainPage"
             Title="AiAudioRecoder">

    <Grid>
        <Image Source="dotnet_bot.png" Aspect="AspectFill" Opacity="0.2" />
        <ScrollView Margin="0,0,0,100">
            <VerticalStackLayout Padding="30,0" Spacing="25">

                <Label Text="Выберите модель Whisper:" FontAttributes="Bold" />
                <Picker x:Name="ModelPicker" Title="Выберите модель">
                    <Picker.ItemsSource>
                        <x:Array Type="{x:Type sys:String}">
                            <x:String>tiny</x:String>
                            <x:String>base</x:String>
                            <x:String>small</x:String>
                            <x:String>medium</x:String>
                        </x:Array>
                    </Picker.ItemsSource>
                </Picker>
                
                <ProgressBar x:Name="DownloadProgress" IsVisible="False" Progress="0" />
                <Button x:Name="DownloadButton"
                        Text="Скачать выбранную модель"
                        Clicked="OnDownloadModelClicked"
                        HorizontalOptions="Fill"
                        BackgroundColor="Blue"
                        TextColor="White" />

                <Label Text="Источник записи:" FontAttributes="Bold" />
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                    <Switch x:Name="SystemAudioSwitch" Grid.Column="0" />
                    <Label Grid.Column="1" 
                           Text="Микрофон (выкл.) / Система (вкл.)"
                           VerticalOptions="Center" />
                </Grid>

                <Button x:Name="RecordButton"
                        Text="Записать аудио"
                        Clicked="OnRecordClicked"
                        HorizontalOptions="Fill"
                        BackgroundColor="Green"
                        TextColor="White" />

                <Button x:Name="ShowRecordsButton"
                        Text="Показать записи"
                        Clicked="OnShowRecordsClicked"
                        HorizontalOptions="Fill"
                        BackgroundColor="Blue"
                        TextColor="White" />

            </VerticalStackLayout>
        </ScrollView>
    </Grid>

</ContentPage>
