<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             x:Class="AiAudioRecoder.MainPage">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25">

            <Label Text="Выберите модель Whisper:" />
            <Picker x:Name="ModelPicker">
                <Picker.ItemsSource>
                    <x:Array Type="{x:Type sys:String}">
                        <x:String>tiny</x:String>
                        <x:String>base</x:String>
                        <x:String>small</x:String>
                        <x:String>medium</x:String>
                    </x:Array>
                </Picker.ItemsSource>
            </Picker>
            <ProgressBar x:Name="DownloadProgress" IsVisible="False" Progress="0" />
            <Button
                x:Name="DownloadButton"
                Text="Скачать выбранную модель"
                Clicked="OnDownloadModelClicked"
                HorizontalOptions="Fill" />
            <Label Text="Источник записи:" />
            <Switch x:Name="SystemAudioSwitch" IsToggled="False" />
            <Label Text="Микрофон (выкл.) / Система (вкл.)" />
            <Button
                x:Name="RecordButton"
                Text="Записать и транскрибировать"
                Clicked="OnRecordAndTranscribeClicked"
                HorizontalOptions="Fill" />
            <Button
                x:Name="StopButton"
                Text="Остановить запись"
                Clicked="OnStopRecordingClicked"
                IsVisible="False"
                BackgroundColor="Red"
                TextColor="White"
                HorizontalOptions="Fill" />
            <Button
                x:Name="ShowRecordsButton"
                Text="Показать записи"
                Clicked="OnShowRecordsClicked"
                HorizontalOptions="Fill" />

            <CollectionView x:Name="RecordsView" IsVisible="False">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,5" Stroke="Gray" StrokeShape="RoundRectangle 8">
                            <VerticalStackLayout>
                                <Label Text="{Binding FilePath}" FontAttributes="Bold" />
                                <Label Text="{Binding StartTime, StringFormat='Начало: {0:yyyy-MM-dd HH:mm:ss}'}" />
                                <Label Text="{Binding EndTime, StringFormat='Конец: {0:yyyy-MM-dd HH:mm:ss}'}" />
                                <Label Text="{Binding Summary}" FontAttributes="Italic" />
                                <Label Text="{Binding Transcription}" LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
