<?xml version="1.0" encoding="utf-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:AiAudioRecoder"
             xmlns:converters="clr-namespace:AiAudioRecoder.Converters"
             x:Class="AiAudioRecoder.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            
            <!-- Converters -->
            <converters:DurationConverter x:Key="DurationConverter" />
            <converters:TranscriptionStatusConverter x:Key="TranscriptionStatusConverter" />
            <converters:StatusColorConverter x:Key="StatusColorConverter" />
            <converters:InverseBoolConverter x:Key="InverseBoolConverter" />
            <converters:FilePathConverter x:Key="FilePathConverter" />
            <converters:QueueStatusConverter x:Key="QueueStatusConverter" />
            
            <!-- Styles for table -->
            <Style x:Key="TableHeaderStyle" TargetType="Label">
                <Setter Property="BackgroundColor" Value="LightBlue" />
                <Setter Property="TextColor" Value="Black" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="HorizontalOptions" Value="Center" />
                <Setter Property="VerticalOptions" Value="Center" />
                <Setter Property="Padding" Value="5" />
            </Style>
            
            <Style x:Key="TableCellStyle" TargetType="Label">
                <Setter Property="BackgroundColor" Value="White" />
                <Setter Property="TextColor" Value="Black" />
                <Setter Property="Padding" Value="5" />
                <Setter Property="LineBreakMode" Value="TailTruncation" />
            </Style>
            
            <Style x:Key="TranscribeButtonStyle" TargetType="Button">
                <Setter Property="BackgroundColor" Value="Blue" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="CornerRadius" Value="5" />
                <Setter Property="Padding" Value="10,5" />
            </Style>
            
            <!-- Status colors -->
            <Color x:Key="TranscribedColor">Green</Color>
            <Color x:Key="PendingColor">Orange</Color>
            <Color x:Key="ErrorColor">Red</Color>
            
        </ResourceDictionary>
    </Application.Resources>
</Application>
