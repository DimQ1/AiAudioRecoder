<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:AiAudioRecoder.Converters"
             x:Class="AiAudioRecoder.RecordPage"
             Title="Records">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:DurationConverter x:Key="DurationConverter" />
            <converters:TranscriptionStatusConverter x:Key="TranscriptionStatusConverter" />
            <converters:StatusColorConverter x:Key="StatusColorConverter" />
            <converters:InverseBoolConverter x:Key="InverseBoolConverter" />
            <converters:FilePathConverter x:Key="FilePathConverter" />
            <!-- Table header style added to ensure sticky header has consistent appearance -->
            <Style x:Key="TableHeaderStyle" TargetType="Label">
                <Setter Property="FontAttributes" Value="Bold" />
                <!-- Use themed background for contrast instead of LightBlue -->
                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Tertiary}}" />
                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}" />
                <Setter Property="Padding" Value="6,4" />
                <Setter Property="HorizontalTextAlignment" Value="Center" />
                <Setter Property="VerticalTextAlignment" Value="Center" />
            </Style>
            <Style x:Key="TableCellStyle" TargetType="Label">
                <Setter Property="Padding" Value="6,4" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="LineBreakMode" Value="TailTruncation" />
            </Style>
            <Style x:Key="ActionButtonStyle" TargetType="Button">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="Padding" Value="8,4" />
                <Setter Property="Margin" Value="0,0,6,0" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray700}}" />
                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}" />
            </Style>
            <Style x:Key="DeleteButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
                <Setter Property="BackgroundColor" Value="Tomato" />
                <Setter Property="TextColor" Value="White" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,*,Auto" Padding="20">
        
    <Border Grid.Row="0" BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray900}}" Padding="10" Margin="0,0,0,10" StrokeThickness="0">
            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                
                <VerticalStackLayout Grid.ColumnSpan="2" Margin="0,0,0,10">
                    <Label Text="Record Source:" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}" />
                    <!-- Changed: use FlexLayout to keep checkboxes in one line and wrap when needed -->
                    <FlexLayout Direction="Row" Wrap="Wrap" AlignItems="Center" JustifyContent="Start" Margin="0,5,0,10">
                        <HorizontalStackLayout Spacing="6" Margin="0,0,30,0">
                            <CheckBox x:Name="MicrophoneCheckBox" IsChecked="True" VerticalOptions="Center" />
                            <Label Text="Microphone" VerticalOptions="Center" TextColor="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}" />
                        </HorizontalStackLayout>
                        <HorizontalStackLayout Spacing="6" Margin="0,0,30,0">
                            <CheckBox x:Name="SystemAudioCheckBox" IsChecked="False" VerticalOptions="Center" />
                            <Label Text="System Audio" VerticalOptions="Center" TextColor="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}" />
                        </HorizontalStackLayout>
                        <HorizontalStackLayout Spacing="6" Margin="0,0,30,0">
                            <CheckBox x:Name="AutoTranscribeCheckBox" IsChecked="True" CheckedChanged="OnAutoTranscribeChanged" VerticalOptions="Center" />
                            <Label Text="Transcribe after" VerticalOptions="Center" TextColor="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}" />
                        </HorizontalStackLayout>
                    </FlexLayout>

                    <HorizontalStackLayout Spacing="20" Margin="0,0,0,10">
                        <VerticalStackLayout WidthRequest="220">
                            <Label Text="Microphone Level" TextColor="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}" />
                            <ProgressBar Progress="{Binding MicLevel}" HeightRequest="10" Margin="0,4,0,0" />
                            <Label Text="{Binding MicLevel, StringFormat='Mic Level: {0:P0}'}" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout WidthRequest="220">
                            <Label Text="System Level" TextColor="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}" />
                            <ProgressBar Progress="{Binding SystemLevel}" HeightRequest="10" Margin="0,4,0,0" />
                            <Label Text="{Binding SystemLevel, StringFormat='System Level: {0:P0}'}" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}" />
                        </VerticalStackLayout>
                    </HorizontalStackLayout>
                    
                    <Grid ColumnDefinitions="*" Margin="0,10,0,0">
                        <!-- Record button updated -->
                        <Button x:Name="RecordButton"
                                Grid.Column="0"
                                Text="Записать"
                                Clicked="OnRecordClicked"
                                BackgroundColor="Green"
                                TextColor="White" />
                    </Grid>
                </VerticalStackLayout>

                <Label Grid.Row="1" 
                       Grid.ColumnSpan="2"
                       x:Name="QueueStatusLabel"
                       Text="Queue: 0 | Active: 0"
                       FontSize="12"
                       TextColor="Gray"
                       HorizontalOptions="Center" />
                
            </Grid>
    </Border>

    <Border Grid.Row="1" BackgroundColor="White" Padding="10" Margin="0,0,0,10" StrokeThickness="0">
            <Grid ColumnDefinitions="*,Auto">
                <Entry x:Name="SearchEntry" 
                       Grid.Column="0"
                       Placeholder="Search content..."
                       TextChanged="OnSearchTextChanged"
					   TextColor="Black" 
					   PlaceholderColor="Gray"
					   BackgroundColor="White"
					   />
                
                <Button Grid.Column="1"
                        Text="Refresh"
                        Clicked="OnShowRecordsClicked"
                        BackgroundColor="Blue"
                        TextColor="White"
                        Margin="10,0,0,0" />
            </Grid>
    </Border>

        <ProgressBar x:Name="TranscriptionProgress"
                     Grid.Row="1"
                     IsVisible="False"
                     Progress="0"
                     Margin="0,10,0,0" />

        <Grid Grid.Row="2" RowDefinitions="Auto,*" Margin="0,0,0,10">
            <!-- Sticky header row: labels now clickable for sorting; Action column set to Auto to fit buttons -->
            <Grid Grid.Row="0" BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Tertiary}}" RowDefinitions="40" ColumnDefinitions="120,120,120,200,Auto,150" ColumnSpacing="1" RowSpacing="1">
                <Label x:Name="DateHeader" Grid.Column="0" Text="Date" ClassId="Date" Style="{StaticResource TableHeaderStyle}">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnHeaderTapped" />
                    </Label.GestureRecognizers>
                </Label>
                <Label x:Name="DurationHeader" Grid.Column="1" Text="Duration" ClassId="Duration" Style="{StaticResource TableHeaderStyle}">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnHeaderTapped" />
                    </Label.GestureRecognizers>
                </Label>
                <Label x:Name="StatusHeader" Grid.Column="2" Text="Status" ClassId="Status" Style="{StaticResource TableHeaderStyle}">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnHeaderTapped" />
                    </Label.GestureRecognizers>
                </Label>
                <Label x:Name="SummaryHeader" Grid.Column="3" Text="Summary" ClassId="Summary" Style="{StaticResource TableHeaderStyle}">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnHeaderTapped" />
                    </Label.GestureRecognizers>
                </Label>
                <Label Grid.Column="4" Text="Action" Style="{StaticResource TableHeaderStyle}" />
                <Label x:Name="FileHeader" Grid.Column="5" Text="File" ClassId="File" Style="{StaticResource TableHeaderStyle}">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnHeaderTapped" />
                    </Label.GestureRecognizers>
                </Label>
            </Grid>
            <ScrollView Grid.Row="1">
                <CollectionView x:Name="RecordsView" ItemsSource="{Binding DisplayedRecords}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Grid RowDefinitions="40" ColumnDefinitions="120,120,120,200,Auto,150" ColumnSpacing="1" Padding="0">
                                <Label Grid.Column="0" Style="{StaticResource TableCellStyle}" Text="{Binding EndTime, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" ClassId="Date">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnCellTapped" />
                                    </Label.GestureRecognizers>
                                </Label>
                                <Label Grid.Column="1" Style="{StaticResource TableCellStyle}" Text="{Binding Duration, Converter={StaticResource DurationConverter}}" ClassId="Duration">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnCellTapped" />
                                    </Label.GestureRecognizers>
                                </Label>
                                <Label Grid.Column="2" Style="{StaticResource TableCellStyle}" Text="{Binding IsTranscribed, Converter={StaticResource TranscriptionStatusConverter}}" TextColor="{Binding IsTranscribed, Converter={StaticResource StatusColorConverter}}" ClassId="Status">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnCellTapped" />
                                    </Label.GestureRecognizers>
                                </Label>
                                <Label Grid.Column="3" Style="{StaticResource TableCellStyle}" Text="{Binding Summary}" ClassId="Summary">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnCellTapped" />
                                    </Label.GestureRecognizers>
                                </Label>
								<FlexLayout Grid.Column="4" Direction="Row" Wrap="NoWrap" AlignItems="Center" JustifyContent="Start" Margin="6,6,6,6">
									<Button Text="Распознать" Style="{StaticResource ActionButtonStyle}" Clicked="OnTranscribeClicked" IsVisible="{Binding IsTranscribed, Converter={StaticResource InverseBoolConverter}}" />
									<Button Text="Повторить" Style="{StaticResource ActionButtonStyle}" Clicked="OnRetranscribeClicked" IsVisible="{Binding IsTranscribed}" />
									<Button Text="Удалить" Style="{StaticResource DeleteButtonStyle}" Clicked="OnDeleteClicked" />
								</FlexLayout>
                                <Label Grid.Column="5" Style="{StaticResource TableCellStyle}" Text="{Binding FilePath, Converter={StaticResource FilePathConverter}}" ClassId="File">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnCellTapped" />
                                    </Label.GestureRecognizers>
                                </Label>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </ScrollView>
        </Grid>

    <Border Grid.Row="3" BackgroundColor="LightGray" Padding="10" StrokeThickness="0">
            <Grid ColumnDefinitions="2*,*,*" ColumnSpacing="20">
                <Label Grid.Column="0" 
                       x:Name="QueueLabel"
                       Text="Queue: 0 tasks"
                       FontSize="12" 
                       TextColor="Gray" />
                
                <Label Grid.Column="1" 
                       x:Name="ActiveLabel"
                       Text="Active: 0 tasks"
                       FontSize="12" 
                       TextColor="Gray" />
                
                <Button Grid.Column="2" 
                        Text="Refresh"
                        Clicked="OnShowRecordsClicked"
                        BackgroundColor="Blue"
                        TextColor="White"
                        FontSize="12" />
            </Grid>
    </Border>

    </Grid>

</ContentPage>
