<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             xmlns:local="clr-namespace:AiAudioRecoder"
             xmlns:models="clr-namespace:AiAudioRecoder.Models"
             x:Class="AiAudioRecoder.ModelsPage">

    <ContentPage.Resources>
        <local:BoolToTextConverter x:Key="BoolToTextConverter" />
        <local:DownloadButtonTextConverter x:Key="DownloadButtonTextConverter" />
        <local:PauseResumeTextConverter x:Key="PauseResumeTextConverter" />
        <local:PauseResumeVisibleConverter x:Key="PauseResumeVisibleConverter" />
        <Style x:Key="ModelBorderStyle" TargetType="Border">
            <Setter Property="Stroke" Value="Transparent" />
            <Setter Property="StrokeThickness" Value="0" />
            <Style.Triggers>
                <DataTrigger TargetType="Border" Binding="{Binding IsCurrent}" Value="True">
                    <Setter Property="Stroke" Value="Blue" />
                    <Setter Property="StrokeThickness" Value="2" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </ContentPage.Resources>

    <Grid>
        <Image Source="dotnet_bot.png" Aspect="AspectFill" Opacity="0.2" />
        <ScrollView>
        <VerticalStackLayout Padding="30,0" Spacing="25">
            <Label Text="Модели Whisper:" />
            <Picker x:Name="DevicePicker" Title="Устройство" SelectedIndexChanged="OnDeviceChanged">
                <Picker.ItemsSource>
                    <x:Array Type="{x:Type sys:String}">
                        <x:String>CPU</x:String>
                        <x:String>GPU</x:String>
                    </x:Array>
                </Picker.ItemsSource>
            </Picker>
            <Picker x:Name="DeviceNumberPicker" Title="Номер устройства GPU" IsVisible="False" SelectedIndexChanged="OnDeviceNumberChanged">
                <Picker.ItemsSource>
                    <x:Array Type="{x:Type sys:String}">
                        <x:String>0</x:String>
                        <x:String>1</x:String>
                        <x:String>2</x:String>
                        <x:String>3</x:String>
                        <x:String>4</x:String>
                        <x:String>5</x:String>
                        <x:String>6</x:String>
                        <x:String>7</x:String>
                    </x:Array>
                </Picker.ItemsSource>
            </Picker>
            <Grid ColumnDefinitions="50,*,100,100,100,100,120" ColumnSpacing="10" Padding="0,10">
                <Label Grid.Column="0" Text="" FontAttributes="Bold" HorizontalOptions="Center" />
                <Label Grid.Column="1" Text="Название" FontAttributes="Bold" />
                <Label Grid.Column="2" Text="Размер" FontAttributes="Bold" />
                <Label Grid.Column="3" Text="Статус" FontAttributes="Bold" />
                <Label Grid.Column="4" Text="Действие" FontAttributes="Bold" />
                <Label Grid.Column="5" Text="Пауза" FontAttributes="Bold" />
                <Label Grid.Column="6" Text="Удалить" FontAttributes="Bold" />
            </Grid>
            <CollectionView x:Name="ModelsCollectionView" ItemsSource="{Binding Models}" SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:ModelInfoDb">
                        <Border Style="{StaticResource ModelBorderStyle}">
                            <Grid ColumnDefinitions="50,*,100,100,100,100,120" ColumnSpacing="10" Padding="5,10">
                                <Label Grid.Column="0" Text="✓" IsVisible="{Binding IsCurrent}" HorizontalOptions="Center" VerticalOptions="Center" />
                                <StackLayout Grid.Column="1" VerticalOptions="Center">
                                    <Label Text="{Binding Name}" />
                                    <ProgressBar IsVisible="{Binding IsDownloading}" Progress="{Binding Progress}" HeightRequest="5">
                                        <ProgressBar.Triggers>
                                            <DataTrigger TargetType="ProgressBar" Binding="{Binding IsPaused}" Value="True">
                                                <Setter Property="IsVisible" Value="True" />
                                            </DataTrigger>
                                        </ProgressBar.Triggers>
                                    </ProgressBar>
                                </StackLayout>
                                <Label Grid.Column="2" Text="{Binding SizeMB, StringFormat='{0:F1} MB'}" VerticalOptions="Center" />
                                <Label Grid.Column="3" Text="{Binding Status}" VerticalOptions="Center" />
                                <Button Grid.Column="4" Text="{Binding ., Converter={StaticResource DownloadButtonTextConverter}}" Clicked="OnModelActionClicked" CommandParameter="{Binding Name}" />
                                <Button Grid.Column="5" Text="{Binding ., Converter={StaticResource PauseResumeTextConverter}}" IsVisible="{Binding ., Converter={StaticResource PauseResumeVisibleConverter}}" Clicked="OnPauseResumeClicked" CommandParameter="{Binding Name}" />
                                <Button Grid.Column="6" Text="Удалить" IsVisible="{Binding IsDownloaded}" Clicked="OnDeleteClicked" CommandParameter="{Binding Name}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
            <Label Text="{Binding Models.Count, StringFormat='Количество моделей: {0}'}" />
            <ProgressBar x:Name="DownloadProgress" IsVisible="False" Progress="0" />
            <Button Text="Импортировать модель из файла" Clicked="OnImportClicked" Margin="0,10,0,0" />
        </VerticalStackLayout>
    </ScrollView>
    </Grid>

</ContentPage>